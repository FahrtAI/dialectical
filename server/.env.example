# Local development only. Production must use oauth and a public HTTPS endpoint.
DIALECTICAL_AUTH_MODE=dev
DIALECTICAL_PORT=8787
DIALECTICAL_DB_PATH=./data/dialectical.sqlite

# Required when DIALECTICAL_AUTH_MODE=oauth.
DIALECTICAL_OAUTH_ISSUER=https://identity.example.com/
DIALECTICAL_OAUTH_AUDIENCE=https://dialectical.example.com
DIALECTICAL_OAUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
DIALECTICAL_RESOURCE_URL=https://dialectical.example.com
DIALECTICAL_DOCUMENTATION_URL=https://dialectical.example.com/docs
